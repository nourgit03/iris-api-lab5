# Copiez ce fichier en ~/lab5.env puis adaptez les 3 premieres lignes.
INITIALES=abc                        # vos initiales, en minuscules, sans accent
LOCATION=francecentral               # une region AUTORISEE (scripts/trouver-region.sh)
NODE_SIZE=Standard_B2als_v2          # taille du noeud AKS (scripts/trouver-region.sh)
RG=rg-lab5-$INITIALES
ACR_NAME=acrlab5${INITIALES}4821     # remplacez 4821 par 4 chiffres a vous
AKS_NAME=aks-lab5-$INITIALES
export MSYS_NO_PATHCONV=1            # Git Bash (Windows) : evite la conversion des chemins
